# =============================================================================
# ZSpeed Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Variables marked [BACKEND] are loaded by backend/src/config.ts (root .env)
# Variables marked [FRONTEND] must be prefixed VITE_ and live in frontend/.env
# Variables marked [SIMULATOR] live in the root .env and are read by the
# simulator backend (backend/src/simulator)
#
# NEVER put JWT_SECRET, ENCRYPTION_KEY, or OEM credentials in VITE_ variables.
# =============================================================================

# --- [BACKEND] Database -------------------------------------------------------
DATABASE_URL=postgresql://zspeed:zspeed_dev@localhost:5432/zspeed
POSTGRES_USER=zspeed
POSTGRES_PASSWORD=zspeed_dev
POSTGRES_DB=zspeed

# --- [BACKEND] Server ---------------------------------------------------------
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (fleet frontend + simulator console)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Fleet ID used in demo mode (no auth)
DEFAULT_FLEET_ID=fleet_demo_001

# --- [BACKEND] Authentication -------------------------------------------------
# Set DEMO_MODE=true for local development (no credentials required).
# Set DEMO_MODE=false in production. This REQUIRES JWT_SECRET and ENCRYPTION_KEY.
DEMO_MODE=true

# Required when DEMO_MODE=false.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# 32-byte UTF-8 string or 64-character hex string. Required when DEMO_MODE=false.
# ENCRYPTION_KEY=

# Fleet accounts used for /api/auth/login when DEMO_MODE=false.
# JSON array: [{"username":"admin","password":"changeme","fleetId":"fleet_001","role":"fleet_manager"}]
# FLEET_ACCOUNTS=

# --- [SIMULATOR] Simulator backend --------------------------------------------
SIMULATOR_PORT=3002
SIMULATOR_ADMIN_KEY=sim-admin-secret-2026

# --- [FRONTEND] Vite environment (frontend/.env) ------------------------------
# Uncomment and set these in frontend/.env, NOT here.
# The frontend NEVER receives backend secrets.

# Override API base URL for a separately hosted backend (default: same origin via proxy)
# VITE_API_BASE_URL=http://localhost:3001

# Override Socket.IO base URL (default: same origin via proxy)
# VITE_SOCKET_URL=http://localhost:3001
